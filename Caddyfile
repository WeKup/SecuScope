# Exemple de reverse proxy HTTPS (Caddy). Copier vers /etc/caddy/Caddyfile sur le VPS.
# Caddy obtient et renouvelle seul le certificat Let's Encrypt (ports 80 et 443 ouverts,
# enregistrement DNS A déjà pointé vers le VPS).
secuscope.maximedarcherif.com {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # 'unsafe-inline' : styles et scripts inline présents dans les templates
        # (style="", onclick="", <script> de index.html). À retirer après refonte en nonces.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        -Server
    }

    reverse_proxy 127.0.0.1:8000
}
