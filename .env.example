# Copier ce fichier en .env et renseigner chaque valeur. Ne jamais committer .env.

# --- Application ---
# Obligatoire : l'app refuse de démarrer sans. Générer par exemple avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Cookie de session Secure (défaut : true). Mettre false UNIQUEMENT pour un test local en HTTP.
SESSION_COOKIE_SECURE=true

# --- Base de données (utilisées par docker-compose pour construire DATABASE_URL) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- IA ---
# Clé Gemini côté serveur, utilisée pour tous les scans. Jamais stockée en base.
GOOGLE_API_KEY=

# --- DNS (optionnel) ---
# Résolveurs interrogés pour les contrôles DNS (défaut : 1.1.1.1,9.9.9.9). Éviter 8.8.8.8 : il tronque
# les grosses réponses TXT (faux « SPF absent »). Laisser vide pour utiliser le résolveur du système.
DNS_RESOLVERS=1.1.1.1,9.9.9.9
